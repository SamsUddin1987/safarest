{
  "id": "/",
  "name": "SAFAR EDGE - CAD & Estimation",
  "short_name": "SAFAR EDGE",
  "description": "SAFAR EDGE browser-based CAD, drawing, estimation and spreadsheet workspace.",
  "start_url": "/cad-workspace/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121212",
